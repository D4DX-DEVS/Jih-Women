# Backend API base URL used by the registration form.
# For local dev: point to your local backend (e.g. http://localhost:4003)
# For production: set this in the Netlify dashboard (Site settings -> Environment
# variables) to your deployed backend URL, e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:4003

# Public website base URL, used by the admin Preview buttons. Required — there
# is no default in the code: when this is unset the Preview buttons are hidden.
# Vite inlines VITE_* at build time, so it must be set when `npm run build`
# runs, not on the running server; changing it needs a rebuild + redeploy.
# For local dev: the web/ Vite server (http://localhost:4000)
# For production: set this in the Netlify dashboard to the live site origin.
VITE_SITE_URL=http://localhost:4000
