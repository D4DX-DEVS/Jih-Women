# Root-level installs (e.g. ad-hoc tooling); app/web/backend keep their own
node_modules/
package-lock.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*.suo

# Env secrets (examples may still be committed inside packages)
.env
.env.*
!.env.example
!**/.env.example

# Logs & build junk
*.log
npm-debug.log*
dist/
dist-ssr/
.smoke/
*.local
